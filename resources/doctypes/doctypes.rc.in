// Windows resources, included into JUCE's resources.rc via JUCE_USER_DEFINED_RC_FILE (generated by CMake)
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",     "Transport\0"
      VALUE "FileDescription", "Transport\0"
      VALUE "FileVersion",     "@PROJECT_VERSION@\0"
      VALUE "ProductName",     "Transport\0"
      VALUE "ProductVersion",  "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

// file-type icons, referenced as "Transport.exe,-<id>"
@TRANSPORT_DOC_ICONS@
